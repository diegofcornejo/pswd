{
  "name": "pswd",
  "type": "module",
  "version": "1.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:style": "stylelint ./**/*.{css,astro,html}",
    "lint:style:fix": "npm run lint:style -- --fix",
    "format": "prettier . --write",
    "prepare": "husky",
    "commit": "git-cz",
    "release": "standard-version --no-verify",
    "release:major": "npm run release -- --release-as major",
    "release:minor": "npm run release -- --release-as minor",
    "release:patch": "npm run release -- --release-as patch"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.13",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "astro-eslint-parser": "3.2.0",
    "autoprefixer": "10.6.2",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "postcss-html": "2.0.1",
    "postcss-nesting": "14.0.3",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "standard-version": "9.5.0",
    "stylelint": "18.0.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-standard": "41.0.0",
    "stylelint-prettier": "5.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
